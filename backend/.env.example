# DevTrack AI — backend environment. Copy to backend/.env (gitignored) and edit.
# Everything below has safe defaults; the app runs fully with NO keys.

ENVIRONMENT=development

# Local dev uses SQLite (zero setup). For Postgres, point this at your instance.
DATABASE_URL=sqlite:///./dev.db

# JWT signing — generate one for any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI provider: "stub" (keyless, deterministic) or "gemini".
AI_PROVIDER=stub
# Get a free key at https://aistudio.google.com/apikey to enable LLM tutoring,
# code review, and RAG answer synthesis. Leave empty to stay on the stub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Codeforces API is public — no key needed.
CODEFORCES_API_BASE=https://codeforces.com/api
