# ==========================================================
# Adaptive Learning OS — environment configuration
# Copy to `.env` and fill in. Never commit the real .env.
# ==========================================================

# ----- App -----
ENVIRONMENT=development
# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Auth -----
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----- Database -----
# Inside docker-compose the host is `db`; running locally it is `localhost`.
DATABASE_URL=postgresql+psycopg2://learnos:learnos@localhost:5433/learnos

# ----- AI provider (swappable; app runs without a key via the stub) -----
# One of: stub | gemini | openai_compatible
AI_PROVIDER=stub
# Google Gemini (default provider once a key is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, local Ollama/vLLM,
# or Gemini's OpenAI-compatible URL). Used when AI_PROVIDER=openai_compatible.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ----- Platform integrations -----
# Codeforces API is public (no key). These are just tuning knobs.
CODEFORCES_API_BASE=https://codeforces.com/api
CODEFORCES_RATE_LIMIT_SECONDS=1.0
